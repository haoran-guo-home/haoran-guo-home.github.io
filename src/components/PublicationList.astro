---
import type { CollectionEntry } from "astro:content";
import { siteConfig } from "../data/site";

interface Props {
  entries: CollectionEntry<"publications">[];
  emptyMessage?: string;
}

const { entries, emptyMessage = "No entries available yet." } = Astro.props;

const linkLabels = {
  paper: "Paper",
  preprint: "Preprint",
  code: "Code",
  slides: "Slides",
  project: "Project",
  doi: "DOI",
} as const;

const getLinks = (entry: CollectionEntry<"publications">) =>
  Object.entries(entry.data.links ?? {}).filter(
    (item): item is [keyof typeof linkLabels, string] =>
      typeof item[1] === "string" && item[1].length > 0,
  );

/** 作者行：首位为本人时用 “with …” */
const formatAuthorsLine = (authors: string[]) => {
  if (authors.length === 0) return "";
  if (authors.length === 1) return authors[0];
  const primary = siteConfig.name;
  if (authors[0] === primary) {
    const rest = authors.slice(1);
    return `with ${rest.join(" and ")}`;
  }
  return authors.join(", ");
};

/** 期刊 / 状态行：已发表突出 venue，否则突出 status */
const venueStatusParts = (entry: CollectionEntry<"publications">) => {
  const { category, venue, status, year } = entry.data;
  if (category === "publication" && venue) {
    return { lead: venue, tail: ` (${year})` };
  }
  if (status) {
    return { lead: status, tail: "" };
  }
  if (venue) {
    return { lead: venue, tail: ` (${year})` };
  }
  return { lead: String(year), tail: "" };
};
---

{entries.length > 0 ? (
  <ul class="publication-list publication-list--academic">
    {entries.map((entry) => {
      const links = getLinks(entry);
      const { lead, tail } = venueStatusParts(entry);
      const bullets = entry.data.bullets ?? [];
      const mediaLinks = entry.data.mediaLinks ?? [];

      return (
        <li class="publication-entry">
          <article class="publication-entry-inner">
            <h3 class="publication-title">{entry.data.title}</h3>
            <p class="publication-authors-line">{formatAuthorsLine(entry.data.authors)}</p>
            <p class="publication-venue-status">
              <strong>{lead}</strong>
              {tail}
            </p>
            {bullets.length > 0 || mediaLinks.length > 0 ? (
              <ul class="publication-bullets">
                {bullets.map((item) => (
                  <li>
                    {item.highlight ? (
                      <>
                        <span class="publication-award">{item.highlight}</span>
                        {item.text ? <> {item.text}</> : null}
                      </>
                    ) : (
                      item.text
                    )}
                  </li>
                ))}
                {mediaLinks.length > 0 ? (
                  <li class="publication-media">
                    <span class="publication-media-label">Media:</span>{" "}
                    {mediaLinks.map((m, index) => (
                      <span class="publication-media-fragment">
                        {index > 0 ? <span class="publication-media-sep">; </span> : null}
                        <a class="publication-inline-link" href={m.href} target="_blank" rel="noreferrer">
                          {m.label}
                        </a>
                        {m.tail ? <span>{m.tail}</span> : null}
                      </span>
                    ))}
                  </li>
                ) : null}
              </ul>
            ) : null}
            {(entry.data.abstract || links.length > 0) ? (
              <div class="publication-actions">
                {entry.data.abstract ? (
                  <details class="publication-abstract">
                    <summary>[Abstract]</summary>
                    <div class="publication-abstract-body">{entry.data.abstract}</div>
                  </details>
                ) : null}
                {links.map(([key, href]) => (
                  <a class="publication-bracket-link" href={href} target="_blank" rel="noreferrer">
                    [{linkLabels[key]}]
                  </a>
                ))}
              </div>
            ) : null}
          </article>
        </li>
      );
    })}
  </ul>
) : (
  <div class="empty-state">{emptyMessage}</div>
)}
