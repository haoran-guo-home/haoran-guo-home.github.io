---
import { getCollection } from "astro:content";
import PublicationList from "../components/PublicationList.astro";
import { bio, researchAreas, siteConfig, socialLinks } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const withBase = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\//, "")}`;
const categoryOrder = {
  publication: 0,
  "working-paper": 1,
  "work-in-progress": 2,
} as const;
const profileLinks = socialLinks.filter((link) => !link.href.startsWith("mailto:"));

const researchEntries = (await getCollection("publications")).sort(
  (left, right) =>
    Number(right.data.featured ?? false) - Number(left.data.featured ?? false) ||
    right.data.year - left.data.year ||
    categoryOrder[left.data.category] - categoryOrder[right.data.category] ||
    left.data.title.localeCompare(right.data.title),
);
---

<BaseLayout description={siteConfig.description}>
  <section class="intro-section" id="about">
    <div class="intro-grid">
      <div class="intro-copy">
        <h1>{siteConfig.name}</h1>
        <p class="intro-subtitle">
          {siteConfig.role} | {siteConfig.affiliation}
        </p>
        {bio.map((paragraph) => (
          <p class="intro-paragraph" set:html={paragraph} />
        ))}

        <div class="research-summary">
          <span class="research-summary-label">Research interests</span>
          <ul class="research-summary-list" aria-label="Research interests">
            {researchAreas.map((area) => (
              <li>{area}</li>
            ))}
          </ul>
        </div>
      </div>

      <aside class="profile-column">
        <div class:list={["profile-photo-shell", { "is-fallback": !siteConfig.avatarUrl }]}>
          {siteConfig.avatarUrl ? (
            <img
              class="profile-photo"
              src={withBase(siteConfig.avatarUrl)}
              alt={`Portrait of ${siteConfig.name}`}
              width="480"
              height="560"
              loading="eager"
              decoding="async"
              onerror="this.closest('.profile-photo-shell')?.classList.add('is-fallback'); this.remove();"
            />
          ) : null}
          <div class="profile-photo-fallback" aria-hidden="true">
            {siteConfig.name
              .split(" ")
              .map((part) => part[0])
              .join("")
              .slice(0, 2)}
          </div>
        </div>

        <div class="profile-links">
          <a class="profile-email" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
          <div class="profile-link-list">
            {profileLinks.map((link) => (
              <a
                class="profile-link"
                href={link.href}
                target={link.href.startsWith("http") ? "_blank" : undefined}
                rel={link.href.startsWith("http") ? "noreferrer" : undefined}
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="research-section" id="research">
    <div class="section-heading">
      <div>
        <h2>Selected research</h2>
      </div>
    </div>
    <PublicationList entries={researchEntries} emptyMessage="Add publication Markdown files to show your research." />
  </section>
</BaseLayout>
