---
import { siteConfig } from "../data/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  pathname?: string;
}

const {
  title,
  description = siteConfig.description,
  pathname = Astro.url.pathname,
} = Astro.props;

const pageTitle = title ? `${title} | ${siteConfig.name}` : `${siteConfig.name} | ${siteConfig.role}`;
const baseUrl = import.meta.env.BASE_URL;
const withBase = (path: string) => `${baseUrl}${path.replace(/^\//, "")}`;
const canonicalUrl = new URL(pathname.replace(/^\//, ""), siteConfig.siteUrl).toString();
const faviconVersion = "20260412";
const faviconSvgPath = `${withBase("/favicon.svg")}?v=${faviconVersion}`;
const faviconPngPath = `${withBase("/favicon.png")}?v=${faviconVersion}`;
const faviconUrl = new URL(faviconPngPath, siteConfig.siteUrl).toString();
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.siteName,
  alternateName: siteConfig.name,
  url: siteConfig.siteUrl,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" sizes="any" href={faviconSvgPath} />
    <link rel="icon" type="image/png" href={faviconPngPath} />
    <link rel="shortcut icon" href={faviconPngPath} />
    <link rel="apple-touch-icon" href={faviconPngPath} />
    <meta name="application-name" content={siteConfig.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={faviconUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </head>
  <body>
    <div class="site-shell">
      <main class="container">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="container footer-inner">
          <p>{siteConfig.name}</p>
          <p>{siteConfig.affiliation}</p>
          <p>Updated: {siteConfig.updatedAt}</p>
        </div>
      </footer>
    </div>
  </body>
</html>
