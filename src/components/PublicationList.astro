---
import type { CollectionEntry } from "astro:content";

interface Props {
  entries: CollectionEntry<"publications">[];
  emptyMessage?: string;
}

const { entries, emptyMessage = "No entries available yet." } = Astro.props;

const linkLabels = {
  paper: "Paper",
  preprint: "Preprint",
  code: "Code",
  slides: "Slides",
  project: "Project",
  doi: "DOI",
} as const;

const getLinks = (entry: CollectionEntry<"publications">) =>
  Object.entries(entry.data.links ?? {}).filter(
    (item): item is [keyof typeof linkLabels, string] =>
      typeof item[1] === "string" && item[1].length > 0,
  );

/** 按钮文字：SSRN 链接显示为 "SSRN"，其余用默认标签 */
const linkLabel = (key: keyof typeof linkLabels, href: string) =>
  key === "paper" && href.includes("ssrn.com") ? "SSRN" : linkLabels[key];

/** 作者行：保持完整作者列表，方便学术主页直接展示 */
const formatAuthorsLine = (authors: string[]) => {
  if (authors.length === 0) return "";
  return authors.join(", ");
};

/** 期刊 / 状态行：期刊名斜体；在审论文只写状态，不加年份 */
const escapeHtml = (text: string) =>
  text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

const detailLine = (entry: CollectionEntry<"publications">) => {
  const { category, venue, status, year } = entry.data;
  if (category === "publication" && venue) {
    return `<em>${escapeHtml(venue)}</em>, ${year}`;
  }
  if (status) {
    const match = status.match(/^(.*\sat\s)(.+)$/);
    return match ? `${escapeHtml(match[1])}<em>${escapeHtml(match[2])}</em>` : escapeHtml(status);
  }
  if (venue) {
    return `<em>${escapeHtml(venue)}</em>, ${year}`;
  }
  return String(year);
};
---

{entries.length > 0 ? (
  <ul class="publication-list">
    {entries.map((entry) => {
      const links = getLinks(entry);
      const bullets = entry.data.bullets ?? [];
      const mediaLinks = entry.data.mediaLinks ?? [];

      return (
        <li class="publication-entry">
          <article class="publication-entry-inner">
            <div class="publication-layout">

              <div class="publication-body">
                <div class="publication-topline">
                  <h3 class="publication-title">{entry.data.title}</h3>
                  {links.length > 0 ? (
                    <div class="publication-links">
                      {links.map(([key, href]) => (
                        <a class="publication-link-button" href={href} target="_blank" rel="noreferrer">
                          {linkLabel(key, href)}
                        </a>
                      ))}
                    </div>
                  ) : null}
                </div>

                <p class="publication-authors-line">{formatAuthorsLine(entry.data.authors)}</p>
                <p class="publication-detail-line" set:html={detailLine(entry)} />

                {bullets.length > 0 ? (
                  <div class="publication-notes">
                    {bullets.map((item) => (
                      <p class="publication-note">
                        {item.highlight ? <span class="publication-award">{item.highlight}</span> : null}
                        {item.text ? <span>{item.text}</span> : null}
                      </p>
                    ))}
                  </div>
                ) : null}

                {mediaLinks.length > 0 ? (
                  <p class="publication-media-block">
                    <span class="publication-media-label">Media Coverage:</span>{" "}
                    {mediaLinks.map((m, index) => (
                      <Fragment>
                        <a class="publication-inline-link" href={m.href} target="_blank" rel="noreferrer">{m.label}</a>
                        {m.tail ? <span>{m.tail}</span> : null}
                        {index < mediaLinks.length - 1 ? "; " : "."}
                      </Fragment>
                    ))}
                  </p>
                ) : null}

                {entry.data.abstract ? (
                  <details class="publication-abstract">
                    <summary>Abstract</summary>
                    <div class="publication-abstract-body">{entry.data.abstract}</div>
                  </details>
                ) : null}
              </div>
            </div>
          </article>
        </li>
      );
    })}
  </ul>
) : (
  <div class="empty-state">{emptyMessage}</div>
)}
