---
import { siteConfig } from "../data/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  pathname?: string;
}

const {
  title,
  description = siteConfig.description,
  pathname = Astro.url.pathname,
} = Astro.props;

const pageTitle = title ? `${title} | ${siteConfig.name}` : siteConfig.name;
const baseUrl = import.meta.env.BASE_URL;
const withBase = (path: string) => `${baseUrl}${path.replace(/^\//, "")}`;
const relativePathname =
  baseUrl !== "/" && pathname.startsWith(baseUrl)
    ? `/${pathname.slice(baseUrl.length).replace(/^\/?/, "")}`
    : pathname;
const canonicalUrl = new URL(pathname.replace(/^\//, ""), siteConfig.siteUrl).toString();
const navItems = [
  { label: "About", href: `${baseUrl}#about`, active: relativePathname === "/" },
  { label: "Publications", href: withBase("/publications/"), active: relativePathname.startsWith("/publications") },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="container header-inner">
          <a class="site-brand" href={withBase("/")}>{siteConfig.name}</a>
          <nav aria-label="Primary navigation">
            <ul class="site-nav">
              {navItems.map((item) => (
                <li>
                  <a class:list={{ active: item.active }} href={item.href}>{item.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </header>

      <main class="container">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="container footer-inner">
          <p>{siteConfig.name}</p>
          <p>{siteConfig.affiliation}</p>
        </div>
      </footer>
    </div>
  </body>
</html>
